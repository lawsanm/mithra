        </mxCell>
        <mxCell id="legend" style="text;html=1;fontSize=11;align=left;verticalAlign=top;spacing=6;fillColor=#FFFFFF;strokeColor=#B0B0B0;rounded=1;" parent="1" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;PK = primary key (underlined) &amp;nbsp;|&amp;nbsp; FK = foreign key (italic) &amp;nbsp;|&amp;nbsp; PF = PK+FK &amp;nbsp;|&amp;nbsp; UK = unique&lt;br&gt;Crow's foot: —| one &amp;nbsp; —&amp;lt; many &amp;nbsp; —o| zero-or-one&lt;br&gt;Five actors (Member, Moderator, Sponsor Liaison, Admin, Sponsor) are a specialisation of &lt;b&gt;users&lt;/b&gt; via &lt;b&gt;roles&lt;/b&gt;; sponsor-specific attributes live in &lt;b&gt;sponsors&lt;/b&gt;.&lt;br&gt;Six point pools are rows of &lt;b&gt;point_pools&lt;/b&gt;; every point movement is an append-only row in &lt;b&gt;point_ledger&lt;/b&gt;." vertex="1">
          <mxGeometry as="geometry" x="40" y="1680" width="900" height="110" />
        </mxCell>
